<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('include/head', { title: 'More Work — ASIM 3310', extraCSS: ['generative.css'] }) %>
  <style>
    .gradient-asim { background: linear-gradient(160deg, #d0ecd8 0%, #e8f0d0 50%, #f8f0c8 100%) !important; }
    nav { --nav-bg: rgba(208,236,216,0.95); background: rgba(208,236,216,0.85); border-bottom: 1px solid rgba(120,180,130,0.2); }

    .work-content { max-width: 1400px; margin: 0 auto; padding: 0 var(--side); }

    .video-full { max-width: 1400px; margin: 0 auto; padding: 0 var(--side) 1rem; }
    .video-full-wrap {
      width: 100%; border-radius: 16px; overflow: hidden;
      background: #0e0a1a; aspect-ratio: 16/9;
    }
    .video-full-wrap.square { aspect-ratio: 1/1; max-width: 720px; }
    .video-full-wrap video {
      width: 100%; height: 100%; object-fit: contain;
      display: block; border-radius: 16px;
    }
    .video-pair { max-width: 1400px; margin: 0 auto; padding: 0 var(--side) 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .video-pair .video-full-wrap { aspect-ratio: 1/1; }
    @media (max-width: 700px) { .video-pair { grid-template-columns: 1fr; } }
    
    .video-caption {
      margin-top: 0.6rem; margin-bottom: 2rem;
      font-family: var(--serif); font-size: 1.15rem;
      font-style: italic; color: var(--text-light);
    }

    .project-block { margin-bottom: 1rem; }
    .project-label {
      font-size: 0.65rem; font-weight: 500; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--text-light); margin-bottom: 1rem;
    }
    .project-body {
      font-size: 1rem; color: var(--text-mid); line-height: 1.85;
      max-width: 680px; margin-bottom: 2.5rem;
    }

    .back-nav {
      max-width: 1400px; margin: 2rem auto 0;
      padding: 2rem var(--side) 5rem;
      border-top: 1px solid rgba(200,170,100,0.2);
    }
    .back-nav a {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--text-mid);
      text-decoration: none; transition: color 0.2s, gap 0.2s;
    }
    .back-nav a:hover { color: var(--text-dark); gap: 0.9rem; }

    @media (max-width: 600px) { :root { --side: 1.2rem; } }
  </style>
</head>
