    /* CONTENT SECTIONS */
    .install-content { max-width: 1400px; margin: 0 auto; padding: 0 var(--side); }
    .section-label {
      font-size: 0.65rem; font-weight: 500; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--text-light); margin-bottom: 1rem;
    }
    .section-body {
      font-size: 1rem; color: var(--text-mid); line-height: 1.85;
      max-width: 680px; margin-bottom: 2rem;
    }

    /* FULL-WIDTH VIDEO */
    .video-full { max-width: 1400px; margin: 0 auto; padding: 0 var(--side) 3rem; }
    .video-full-wrap {
      width: 100%; border-radius: 16px; overflow: hidden;
      background: #0e0a1a; aspect-ratio: 16/9;
    }
    .video-full-wrap video {
      width: 100%; height: 100%; object-fit: cover;
      display: block; border-radius: 16px;
    }
    .video-full-wrap img {
      width: 100%; height: auto; display: block;
      border-radius: 16px; object-fit: cover;
    }
    .video-full-caption {
      margin-top: 0.7rem; font-family: var(--serif);
      font-size: 0.9rem; font-style: italic; color: var(--text-light);
    }

    /* BACK NAV */
    .back-nav {
      max-width: 1400px; margin: 2rem auto 0;
      padding: 2rem var(--side) 5rem;
      border-top: 1px solid rgba(200,170,100,0.2);
    }
    .back-nav a {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--text-mid);
      text-decoration: none; transition: color 0.2s, gap 0.2s;
    }
    .back-nav a:hover { color: var(--text-dark); gap: 0.9rem; }

    @media (max-width: 600px) { :root { --side: 1.2rem; } }
  </style>
</head>
