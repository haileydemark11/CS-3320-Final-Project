<%- include('include/header-nav') %>

<div class="page-hero">
  <a href="/portfolio/generative-art" class="back-link">&#8592; Back to Generative Art</a>
  <p class="page-eyebrow">Installation &mdash; Fall 2025</p>
  <h1 class="page-title">Tree of<br>Life</h1>
  <p class="page-desc">An audio-reactive generative installation exploring the relationship between natural growth systems and live musical composition.</p>
  <div class="page-tags">
    <span class="tag">TouchDesigner</span>
    <span class="tag">Sonic Pi</span>
    <span class="tag">Adobe Photoshop</span>
